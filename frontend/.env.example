# Copy to frontend/.env and fill in values (never commit .env)

# Backend API — leave commented until FastAPI is running on :8000
# VITE_API_URL=http://localhost:8000

# Demo pitch: hide “mock data” dev hint in filters
VITE_DEMO=true

# Mapbox — public token (pk.*) from https://account.mapbox.com/access-tokens/
# Used for: light map tiles + address/Eircode search
VITE_MAPBOX_TOKEN=
# Optional: mapbox/streets-v12 (default, Google-like) | mapbox/light-v11 | mapbox/outdoors-v12
# VITE_MAPBOX_STYLE=mapbox/streets-v12

# Optional: fixed location for station / kiosk screens
# VITE_KIOSK_MODE=true
# VITE_KIOSK_LAT=53.3509
# VITE_KIOSK_LNG=-6.2499
# VITE_KIOSK_LABEL=Connolly Station
